<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mercury_rviz</name>
  <version>0.0.0</version>
  <description>Rviz control and visualization interface</description>
  <maintainer email="rosati.33@osu.edu">Ethan Rosati</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- General deps -->
  <depend>yaml-cpp</depend>
  <depend>tf2</depend>
  <depend>tinyxml2_vendor</depend>
  <depend>pluginlib</depend>
  <depend>resource_retriever</depend>
  <depend>mercury_meshes</depend>

  <!-- MSG deps -->
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mercury_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>chameleon_tf_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>interactive_markers</depend>

  <!-- ROS deps-->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>ament_index_cpp</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>rviz_ogre_vendor</depend>
  <depend>robot_localization</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
