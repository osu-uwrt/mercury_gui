Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 140
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
  - Class: riptide_rviz/MissionPanel
    Name: MissionPanel
    robot_namespace: "/liltank"
  - Class: riptide_rviz/ElectricalPanel
    Name: ElectricalPanel
    robot_namespace: /liltank
  - Class: riptide_rviz/DiagnosticsPanel
    Name: DiagnosticsPanel
    robot_namespace: ""
  - Class: riptide_rviz/ParamPanel
    Name: ParamPanel
    robot_namespace: /liltank
  - Class: riptide_rviz/MappingPanel
    Name: MappingPanel
    mapCalibNumSamples: 10
    robot_namespace: /liltank
    tagFrameName: tag_36h11
    worldFrameName: world
  - Class: riptide_rviz/ControlPanel
    Name: ControlPanel
    max_depth_in_place: 0
    odom_timeout: 1
    robot_namespace: "/liltank"
    tgt_in_place_depth: 2.2132416109254e-311
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        bin_target_frame:
          Value: true
        buoy_frame:
          Value: true
        gate_cold_frame:
          Value: true
        gate_frame:
          Value: true
        gate_hot_frame:
          Value: true
        liltank/base_inertia:
          Value: true
        liltank/base_link:
          Value: true
        liltank/ffc_base_link:
          Value: true
        liltank/ffc_camera_link:
          Value: true
        liltank/imu_link:
          Value: true
        liltank/imu_revolute_link:
          Value: true
        liltank/origin:
          Value: true
        liltank/pose_sensor_link:
          Value: true
        liltank/pressure_link:
          Value: true
        liltank/thruster_0:
          Value: true
        liltank/thruster_1:
          Value: true
        map:
          Value: true
        odom:
          Value: true
        offset:
          Value: true
        prequal_gate_frame:
          Value: true
        prequal_pole_frame:
          Value: true
        simulator/bouy:
          Value: true
        simulator/buoy:
          Value: true
        simulator/gate:
          Value: true
        simulator/liltank/base_link:
          Value: true
        simulator/liltank/zed2i/left_optical:
          Value: true
        simulator/path:
          Value: true
        simulator/torpedo:
          Value: true
        table_frame:
          Value: true
        torpedo_frame:
          Value: true
        torpedo_large_hole_frame:
          Value: true
        torpedo_small_hole_frame:
          Value: true
        world:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        world:
          map:
            offset:
              bin_target_frame:
                {}
              buoy_frame:
                {}
              gate_cold_frame:
                {}
              gate_frame:
                {}
              gate_hot_frame:
                {}
              prequal_gate_frame:
                {}
              prequal_pole_frame:
                {}
              table_frame:
                {}
              torpedo_frame:
                {}
              torpedo_large_hole_frame:
                {}
              torpedo_small_hole_frame:
                {}
          odom:
            liltank/base_link:
              liltank/origin:
                liltank/base_inertia:
                  {}
                liltank/ffc_base_link:
                  liltank/ffc_camera_link:
                    {}
                liltank/imu_link:
                  {}
                liltank/imu_revolute_link:
                  {}
                liltank/pressure_link:
                  {}
                liltank/thruster_0:
                  {}
                liltank/thruster_1:
                  {}
              liltank/pose_sensor_link:
                {}
            simulator/liltank/base_link:
              simulator/liltank/zed2i/left_optical:
                {}
          simulator/bouy:
            {}
          simulator/buoy:
            {}
          simulator/gate:
            {}
          simulator/path:
            {}
          simulator/torpedo:
            {}
      Update Interval: 0
      Value: true
    - Alpha: 0.949999988079071
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /liltank/robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        liltank/base_inertia:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        liltank/base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        liltank/ffc_base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        liltank/ffc_camera_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        liltank/imu_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        liltank/imu_revolute_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        liltank/origin:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        liltank/pose_sensor_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        liltank/pressure_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        liltank/thruster_0:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        liltank/thruster_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Mapping Markers
      Namespaces:
        mapping_markers: true
        simGhost: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /liltank/mapping_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Collision Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /liltank/simulator/collisionMarkers
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.3771135807037354
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.4403977394104004
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.9953974485397339
    Saved: ~
